+# ---------------------------------------------------------------------------
+#  Кэш, привязанный к версии данных (versioned_cache)
+# ---------------------------------------------------------------------------
+@st.cache_data(ttl=300, show_spinner=False)
+def _data_version() -> str:
+    """Версия данных: время последней синхронизации + число листов.
+
+    Меняется после каждой синхронизации → все загрузчики с
+    @versioned_cache автоматически получают свежие данные,
+    без st.cache_data.clear() (по правилам проекта — только admin).
+    """
+    try:
+        with get_conn() as conn:
+            row = conn.execute(
+                "SELECT MAX(timestamp) FROM log WHERE event = 'refresh'"
+            ).fetchone()
+            last_sync = row[0] if row and row[0] else "never"
+            sheets = conn.execute(
+                "SELECT COUNT(*) FROM documents").fetchone()[0]
+    except Exception:
+        return "unknown"
+    return f"{last_sync}|{sheets}"
+
+
+def versioned_cache(ttl: int = 3600):
+    """Декоратор кэша с инвалидацией по версии данных.
+
+    В отличие от чистого @st.cache_data результат живёт не только
+    по ttl: при смене версии данных (после синхронизации) ключ
+    меняется и запрос выполняется заново.
+
+    Механика: обёрнутая функция регистрируется в реестре по строковому
+    ключу, а в кэшируемую диспетчер-функцию передаются только хэшируемые
+    аргументы (имя загрузчика, версия данных, ttl, параметры запроса).
+    Streamlit не умеет хэшировать аргументы-функции, поэтому схема
+    построена на реестре.
+    """
+    def deco(func):
+        fn_key = f"{func.__module__}.{func.__qualname__}"
+        _CACHE_REGISTRY[fn_key] = func
+
+        @wraps(func)
+        def wrapper(*args, **kwargs):
+            return _cached_call(fn_key, _data_version(), ttl,
+                                *args, **kwargs)
+
+        return wrapper
+    return deco
+
+
+# Реестр «имя загрузчика → функция». Наполняется декоратором
+# versioned_cache при импорте модуля.
+_CACHE_REGISTRY: dict = {}
+
+
+@st.cache_data(ttl=3600, show_spinner=False)
+def _cached_call(fn_key: str, data_ver: str, ttl: int, *args, **kwargs):
+    """Диспетчер: выполняет загрузчик из реестра и кэширует результат.
+
+    Все аргументы входят в ключ кэша: смена data_ver после
+    синхронизации даёт новый ключ → свежие данные без clear().
+    """
+    return _CACHE_REGISTRY[fn_key](*args, **kwargs)
+
