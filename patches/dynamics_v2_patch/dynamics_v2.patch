+def _build_donut_figure(done: int, plan_total: int):
+    """Бублик «выполнено / осталось» с процентом в центре.
+
+    Возвращает (fig, процент, осталось).
+    """
+    remaining = max(0, plan_total - done)
+    pct = min(100, int(round(done / plan_total * 100))) if plan_total else 0
+
+    df = pd.DataFrame({
+        "Категория": ["Выполнено", "Осталось"],
+        "Значение": [done, remaining],
+    })
+    fig = px.pie(
+        df,
+        values="Значение",
+        names="Категория",
+        hole=0.45,
+        color="Категория",
+        color_discrete_map={"Выполнено": "#2E7D32", "Осталось": "#B0BEC5"},
+    )
+    fig.update_traces(
+        textposition="inside",
+        textinfo="value",
+        hovertemplate="%{label}: %{value}<extra></extra>",
+    )
+    fig.add_annotation(
+        text=f"<b>{pct}%</b>",
+        x=0.5, y=0.5, xref="paper", yref="paper",
+        showarrow=False,
+        font=dict(size=26, color="#263238"),
+    )
+    fig.update_layout(
+        showlegend=False,
+        margin=dict(t=10, b=10, l=10, r=10),
+        height=260,
+    )
+    return fig, pct, remaining
+
+
+def _render_progress_donuts(disciplines: tuple, sections: tuple,
+                            kits: tuple, block_codes: tuple):
+    """Бублики сравнения с планом: комплекты и листы.
+
+    «Выполнено» — сколько уже есть в Витро (_load_doc_totals),
+    «Осталось» — план из Ведомости комплектов (plan_kits) минус
+    выполненное. План фильтруется по комплекту, расположению
+    (4-й блок шифра) и дисциплинам/разделам (через documents).
+    """
+    st.markdown("### 🎯 Выполнение плана (Ведомость комплектов)")
+
+    plan = _load_plan()
+    if not plan:
+        st.info(
+            "План не задан: таблица `plan_kits` не найдена или пуста. "
+            "Загрузите Ведомость комплектов — и бублики появятся."
+        )
+        return
+
+    scope = _load_scope_codes(disciplines, sections)
+    items = [
+        (code, vals) for code, vals in plan.items()
+        if (not kits or code in kits)
+        and (not block_codes or _extract_4th_block(code) in block_codes)
+        and ((not disciplines and not sections) or code in scope)
+    ]
+
+    plan_kits_total = sum(v["kits"] for _, v in items)
+    plan_sheets_total = sum(v["sheets"] for _, v in items)
+
+    if plan_kits_total == 0 and plan_sheets_total == 0:
+        st.info(
+            "В таблице `plan_kits` нет плановых значений для "
+            "выбранной комбинации фильтров."
+        )
+        return
+
+    totals = _load_doc_totals(disciplines, sections, kits, block_codes)
+
+    col1, col2 = st.columns(2)
+
+    with col1:
+        st.markdown("##### 🏗 Комплекты")
+        fig, _pct, remaining = _build_donut_figure(
+            totals["kits"], plan_kits_total)
+        st.plotly_chart(fig, use_container_width=True, key="dyn_donut_kits")
+        st.markdown(
