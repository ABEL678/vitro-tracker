+#  План (Ведомость комплектов) и бублики выполнения
+# ---------------------------------------------------------------------------
+_PLAN_TABLE = "plan_kits"
+
+
+@versioned_cache(ttl=600)
+def _load_plan() -> dict:
+    """План комплектов/листов из Ведомости комплектов (plan_kits).
+
+    Ожидаемая структура таблицы:
+
+        CREATE TABLE plan_kits (
+            complex     TEXT PRIMARY KEY,  -- шифр комплекта (как documents.complex)
+            plan_kits   INTEGER,           -- план, комплектов
+            plan_sheets INTEGER            -- план, листов
+        );
+
+    Колонки распознаются автоматически по именам. Если таблицы нет
+    или в ней нет колонки с шифром — возвращается пустой словарь
+    (вкладка показывает подсказку вместо бубликов).
+    """
+    with get_conn() as conn:
+        exists = conn.execute(
+            "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
+            (_PLAN_TABLE,),
+        ).fetchone()
+        if not exists:
+            return {}
+
+        cols = [r[1] for r in conn.execute(
+            f"PRAGMA table_info({_PLAN_TABLE})")]
+        code_col = next(
+            (c for c in ("complex", "code", "kit", "cipher", "kit_code")
+             if c in cols), None)
+        kits_col = next(
+            (c for c in ("plan_kits", "kits", "kits_plan", "kit_plan")
+             if c in cols), None)
+        sheets_col = next(
+            (c for c in ("plan_sheets", "sheets", "sheets_plan", "sheet_plan")
+             if c in cols), None)
+        if not code_col:
+            return {}
+
+        parts = [f'"{code_col}" AS code']
+        parts.append(f'COALESCE("{kits_col}", 0) AS kits' if kits_col
+                     else "0 AS kits")
+        parts.append(f'COALESCE("{sheets_col}", 0) AS sheets' if sheets_col
+                     else "0 AS sheets")
+        rows = conn.execute(
+            f"SELECT {', '.join(parts)} FROM {_PLAN_TABLE}").fetchall()
+
+    plan: dict[str, dict] = {}
+    for r in rows:
+        code = str(r["code"] or "").strip()
+        if not code:
+            continue
+        try:
+            k = int(float(r["kits"] or 0))
+            s = int(float(r["sheets"] or 0))
+        except (ValueError, TypeError):
+            k, s = 0, 0
+        plan[code] = {"kits": max(0, k), "sheets": max(0, s)}
+    return plan
+
+
+@versioned_cache(ttl=3600)
+def _load_doc_totals(disciplines: tuple, sections: tuple,
+                     kits: tuple, block_codes: tuple) -> dict:
+    """Сколько комплектов и листов УЖЕ есть в Витро (всего, без периода).
+
+    «Выполнено» для бубликов сравнения с планом.
+    """
+    where, params = _build_filter_sql(
+        disciplines, sections, kits, block_codes,
+        None, None, "d.status_date")
+    q = f"""
+        SELECT COUNT(DISTINCT d.complex) AS kits, COUNT(*) AS sheets
+        FROM documents d
+        WHERE d.complex IS NOT NULL {where}
+    """
+    with get_conn() as conn:
+        row = conn.execute(q, tuple(params)).fetchone()
+    return {"kits": int(row["kits"] or 0), "sheets": int(row["sheets"] or 0)}
+
+
+@versioned_cache(ttl=600)
+def _load_scope_codes(disciplines: tuple, sections: tuple) -> frozenset:
+    """Комплекты, встречающиеся в documents с учётом дисциплин/разделов.
+
+    Нужно, чтобы сузить план при фильтрации по дисциплине/разделу:
+    в plan_kits этих колонок может не быть.
+    """
+    where_parts, params = [], []
+    if disciplines:
+        where_parts.append(
+            f"discipline IN ({','.join('?' * len(disciplines))})")
+        params += list(disciplines)
+    if sections:
+        where_parts.append(
+            f"section IN ({','.join('?' * len(sections))})")
+        params += list(sections)
+    where = f" WHERE {' AND '.join(where_parts)}" if where_parts else ""
+    with get_conn() as conn:
+        rows = conn.execute(
+            f"SELECT DISTINCT complex FROM documents{where}",
+            tuple(params),
+        ).fetchall()
+    return frozenset(r["complex"] for r in rows if r["complex"])
+
