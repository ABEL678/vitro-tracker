+def _fill_drawing_row_meta(drawings: pd.DataFrame,
+                           kits_df: pd.DataFrame) -> pd.DataFrame:
+    """Заполняет пустые дисциплину/раздел строк plan_drawings — записи
+    старых версий парсера (до 07) чинятся на лету, без перезагрузки
+    файлов: дисциплина — из комплекта общей таблицы (уже каноничен),
+    затем из шифра; раздел — из комплекта, затем пусто. Новые загрузки
+    и так полные (plan_xlsx.py)."""
+    if drawings.empty:
+        return drawings
+    kit_disc: dict[str, str] = {}
+    kit_sect: dict[str, str] = {}
+    if kits_df is not None and not kits_df.empty:
+        kit_disc = dict(zip(kits_df["code"].astype(str),
+                            kits_df["discipline"].fillna("").astype(str)))
+        kit_sect = dict(zip(kits_df["code"].astype(str),
+                            kits_df["section"].fillna("").astype(str)))
+    out = drawings.copy()
+    codes = out["kit_code"].astype(str)
+    disc = out["discipline"].fillna("").astype(str).str.strip()
+    sect = out["section"].fillna("").astype(str).str.strip()
+    out["discipline"] = [
+        d or kit_disc.get(k, "")
+        or _canon_discipline(_discipline_from_code(k))
+        for k, d in zip(codes, disc)
+    ]
+    out["section"] = [s or kit_sect.get(k, "") for k, s in zip(codes, sect)]
+    return out
+
+
+def _donut_numbers(overview_filtered: pd.DataFrame, flt: dict) -> dict:
+    """Чистая математика бубликов (без UI) — С УЧЁТОМ ФИЛЬТРОВ.
+
+      overview_filtered — результат _apply_overview_filters (фильтры на
+                          уровне комплектов); строки «Только в Витро»
+                          исключаются: «Комплектов всего» — это всегда
+                          ведомость комплектов;
+      flt               — фильтры вкладки: к ЛИСТАМ дополнительно
+                          применяются дисциплина/раздел на уровне строк
+                          чертежей и «Только позиции со сроками».
+
+      kits_total    — комплектов в ведомости (после фильтров);
+      kits_loaded   — сколько из них есть в documents (Витро);
+      kits_plan     — разница;
+      sheets_total  — Σ листов отфильтрованных строк plan_drawings;
+      sheets_loaded — Σ min(план, Витро) по затронутым комплектам
+                      (загруженные листы Витро не привязаны к разделам,
+                      поэтому min — принятая оценка);
+      sheets_plan   — разница (не сумма);
+      sheets_excess — листы Витро сверх плана (в бублик не входят);
+      kits_missing_drawings — комплекты без листов в ведомостях
+                              чертежей (по текущим фильтрам).
+    """
+    kits = overview_filtered
+    if kits is not None and not kits.empty:
+        kits = kits[kits["status"] != "Только в Витро"]
+    else:
+        kits = pd.DataFrame()
+    kit_codes = (set(kits["code"].astype(str))
+                 if not kits.empty else set())
+    n_total = len(kit_codes)
+    n_loaded = (int(kits["in_vitro"].astype(bool).sum())
+                if not kits.empty else 0)
+
+    drw = _load_drawings_cached()
+    if not drw.empty and kit_codes:
+        drw = drw[drw["kit_code"].astype(str).isin(kit_codes)].copy()
+    else:
+        drw = drw.iloc[0:0]
+    if not drw.empty:
+        drw = _fill_drawing_row_meta(drw, kits)
+        if flt["disc"]:
+            drw = drw[drw["discipline"].isin(flt["disc"])]
+        if flt["section"]:
+            drw = drw[drw["section"].isin(flt["section"])]
+        if flt["extra"].get("only_dated"):
+            due_by_kit = (dict(zip(kits["code"].astype(str), kits["due_date"]))
+                          if not kits.empty else {})
+            has_date = (drw["planned_date"].notna()
+                        & (drw["planned_date"].astype(str) != ""))
+            kit_dated = drw["kit_code"].astype(str).map(
+                lambda k: bool(due_by_kit.get(k)))
+            drw = drw[has_date | kit_dated]
+
+    plan_qty = (drw.groupby("kit_code")["qty"].sum().to_dict()
+                if not drw.empty else {})
+    vitro = _vitro_sheet_counts()
+    sheets_total = int(sum(plan_qty.values()))
+    sheets_loaded = int(sum(min(q, vitro.get(k, 0))
+                            for k, q in plan_qty.items()))
+    sheets_excess = int(sum(max(vitro.get(k, 0) - q, 0)
+                            for k, q in plan_qty.items()))
+    kits_missing_drawings = sorted(kit_codes - set(plan_qty))
+
+    return {
+        "kits_total": n_total,
+        "kits_loaded": n_loaded,
+        "kits_plan": n_total - n_loaded,
+        "sheets_total": sheets_total,
+        "sheets_loaded": sheets_loaded,
+        "sheets_plan": sheets_total - sheets_loaded,
+        "sheets_excess": sheets_excess,
+        "kits_missing_drawings": kits_missing_drawings,
+    }
 
 
