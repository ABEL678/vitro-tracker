index b3f5e8d..15b65e2 100644
--- a/vitro/config.py
+++ b/vitro/config.py
@@ -7,9 +7,15 @@ VITRO_USER = os.getenv("VITRO_USER", "")
 VITRO_PASSWORD = os.getenv("VITRO_PASSWORD", "")
