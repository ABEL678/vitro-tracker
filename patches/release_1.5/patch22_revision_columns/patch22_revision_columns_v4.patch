+    wb = openpyxl.Workbook()
+    ws = wb.active
+    ws.title = "Комплекты"
+    if title_rows:
+        # Титульные строки бланка ВЫШЕ шапки (шапка не в строке 1):
+        # полоса даты должна встать на строку выше шапки, титул —
