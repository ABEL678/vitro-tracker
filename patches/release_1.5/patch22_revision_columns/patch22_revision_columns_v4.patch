# ============================================================================
# База: HEAD 5af8de9 release/1.5-plan (export.py = blob 0d20cfe).
# Патч ЗАМЕНЯЕТ собой patch22_revision_columns_v2.patch,
# patch22_revision_columns_v3.patch и правки 5d465a4: применяйте на
# файлах, приведённых к состоянию 5af8de9 (команда ниже).
#
# Состав:
#   1. vitro/sheets.py — хелперы ревизий комплектов
#      (get_kit_revision_info, _format_rev_date);
#   2. vitro/ui/export.py
#      - режим 1 (_styled_upload_to_xlsx): строка полосы вставляется
#        ПЕРЕД строкой шапки (strip_row = header_row_idx) — полоса
#        стоит СРАЗУ НАД шапками kit-колонок независимо от того, с
#        какой строки листа начинается таблица: титульные строки
#        бланка выше шапки НЕ сдвигаются, шапка и данные уезжают на
#        строку вниз. Полоса — заливка E8F0F8 и тонкая рамка
#        #808080 во всю ширину таблицы, ТЕКСТ «База актуальна на …»
#        объединён ровно над шапками трёх добавляемых kit-колонок
#        (col_status..col_date), по центру, жирный, высота 22;
#      - merges исходника при возврате сдвигаются ТОЛЬКО если они
#        ниже строки полосы; выше полосы — без сдвига; merge,
#        охватывающий место вставки, расширяется на строку (как это
#        делает сам Excel);
#      - фиксы от «восстановления файла» Excel (обязательны вместе):
#        22.2 — снятие Excel-таблиц (ListObject) с целевого листа;
#        22.3 — merge-диапазоны исходника снимаются до insert_rows
#               (openpyxl их не сдвигает);
#      - автофильтр строго A{шапка}:…{последняя строка данных},
#        без данных автофильтр не ставится;
#      - из 5d465a4 сохранены: словарь {строка: шифр} (пустые строки
#        в середине данных не сдвигают kit-значения) и
#        last_row = header_row_idx (пустая таблица);
#      - режим 2 (_styled_df_to_xlsx, fallback): сборка книги «с
#        нуля», строка 1 — полоса, строка 2 — шапка (та же геометрия
#        текста над kit-колонками);
#   3. scripts/test_patch22.py     — 73 проверки (fallback-режим);
#   4. scripts/test_patch22_3.py   — 61 проверка (режим загрузки
#      файла: Excel-таблица, merge-заголовок, широкий баннер,
#      пустая строка в данных, примечание под таблицей, пустая
#      таблица, чужая таблица, ТИТУЛЬНЫЕ СТРОКИ выше шапки).
#
# Применение (в корне репозитория; база — публичный HEAD 5af8de9):
#   git checkout 5af8de9 -- vitro/sheets.py vitro/ui/export.py scripts/test_patch22.py
#   rm -f scripts/test_patch22_3.py
#   git apply patches/patch22_revision_columns_v4.patch
#
# Проверка:
#   python -m py_compile vitro/ui/export.py vitro/sheets.py
#   python scripts/test_patch22.py    -> 73 проверки, EXIT=0
#   python scripts/test_patch22_3.py  -> 61 проверка, EXIT=0
